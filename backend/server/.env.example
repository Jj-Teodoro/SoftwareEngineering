# Copy this file to .env and fill in the values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Postgres - Dashboard > Connect > "Session pooler" (works on IPv4 networks)
# Leave DB_HOST empty to use the local SQLite database instead.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.bdslcegvvvcgvjwxblyi
DB_PASSWORD=your-supabase-database-password
