{
  "name": "oasis-workspace",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "frontend/shared",
    "frontend/admin-site",
    "frontend/scanner-site",
    "frontend/user-site"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w @oasis/admin-site",
    "dev:scanner": "npm run dev -w @oasis/scanner-site",
    "dev:user": "npm run dev -w @oasis/user-site",
    "build": "npm run build -w @oasis/admin-site -w @oasis/scanner-site -w @oasis/user-site"
  }
}
